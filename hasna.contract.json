{
  "schema": "hasna.service_contract.v1",
  "name": "knowledge",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.4.1",
  "description": "Stage-A local knowledge store with CLI, MCP, contained HTTP metadata, and a generated SDK. Executable storage is limited to the local SQLite workspace at ~/.hasna/knowledge/knowledge.db; hosted and cloud execution remain contained.",
  "bins": ["knowledge", "knowledge-mcp", "knowledge-serve"],
  "storage": {
    "mode": "local",
    "envPrefix": "HASNA_KNOWLEDGE_",
    "aliasEnvPrefix": "KNOWLEDGE_",
    "sqlitePath": "~/.hasna/knowledge/knowledge.db"
  },
  "metadata": {
    "service": {
      "port": 8080,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "contained"
    },
    "client": {
      "apiUrlEnv": "KNOWLEDGE_API_URL"
    },
    "cloud": {
      "state": "contained",
      "executable": false
    }
  }
}
