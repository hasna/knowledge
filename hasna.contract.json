{
  "schema": "hasna.service_contract.v1",
  "name": "knowledge",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.8.5",
  "description": "Agent-friendly knowledge store. CLI + MCP + HTTP API (knowledge-serve) + generated SDK. SQLite backend uses ~/.hasna/knowledge/knowledge.db; postgres backend (HASNA_KNOWLEDGE_STORAGE_MODE=postgres) routes clients through the HTTP API and lets knowledge-serve read/write the shared Postgres directly, with API-key auth via @hasna/contracts.",
  "bins": [
    "knowledge",
    "knowledge-mcp",
    "knowledge-serve"
  ],
  "storage": {
    "mode": "sqlite",
    "envPrefix": "HASNA_KNOWLEDGE_",
    "aliasEnvPrefix": "KNOWLEDGE_",
    "databaseUrlSecretRef": "hasna/oss/knowledge/database-url",
    "sqlitePath": "~/.hasna/knowledge/knowledge.db"
  },
  "metadata": {
    "service": {
      "port": 8080,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "signingSecretSecretRef": "hasna/oss/knowledge/api-key-signing-secret",
      "migrationCommand": [
        "bun",
        "scripts/apply-cloud-migrations.mjs"
      ],
      "ownerDatabaseUrlSecretRef": "hasna/oss/knowledge/database-url-owner"
    },
    "client": {
      "apiUrlEnv": "KNOWLEDGE_API_URL",
      "apiKeyEnv": "KNOWLEDGE_API_KEY"
    }
  }
}
